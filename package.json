{
  "name": "editin",
  "version": "1.0.0",
  "description": "EditIn // Fast, Private & Offline PDF Editor and Document Studio",
  "author": "Ngoods",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "tsc && vite build && electron-builder --dir",
    "package:appx": "tsc && vite build && electron-builder --win appx",
    "preview": "vite preview"
  },
  "build": {
    "appId": "Ngoods.EditIn",
    "productName": "EditIn",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "dir",
      "icon": "resources/icons/icon.ico"
    },
    "appx": {
      "identityName": "Ngoods.EditIn",
      "publisher": "CN=A92523C4-5EF5-4F58-85A8-408E3D78A880",
      "publisherDisplayName": "Ngoods",
      "applicationId": "EditIn",
      "backgroundColor": "#0C0D12"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
